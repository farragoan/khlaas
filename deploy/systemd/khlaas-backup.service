[Unit]
Description=khlaas PostgreSQL backup
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/khlaas/deploy/scripts/backup.sh
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/backups/khlaas
ProtectHome=yes
PrivateTmp=yes
