# Comma-separated Clerk user IDs allowed to access admin routes; optional.
ADMIN_USER_IDS=CHANGE_ME
# Clerk server secret used by ClerkProvider and clerkMiddleware; required.
CLERK_SECRET_KEY=CHANGE_ME
# Release SHA reported by health checks; optional, set to the deployed commit.
COMMIT_REF=CHANGE_ME
# PostgreSQL connection for Next.js, the pg-boss worker, sweeps and dbmate; required.
DATABASE_URL=postgres://khlaas:CHANGE_ME@127.0.0.1:5432/khlaas
# Google AI Studio receipt OCR credential; required unless OpenRouter is used.
GOOGLE_AI_STUDIO_API_KEY=CHANGE_ME
# Next.js base path, inlined into the browser bundle at build time; required.
NEXT_PUBLIC_BASE_PATH=/khlaas
# Clerk publishable key inlined into the browser bundle; required.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=CHANGE_ME
# PostHog browser/server endpoint; optional, defaults to https://us.i.posthog.com.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# PostHog project key inlined into the browser bundle; optional.
NEXT_PUBLIC_POSTHOG_KEY=
# Node runtime mode; the systemd units also set this explicitly.
NODE_ENV=production
# OpenRouter receipt OCR credential; required only when USE_OPENROUTER=true.
OPENROUTER_API_KEY=
# Overrides the trusted client-IP header; optional, normally unset behind the Worker.
TRUSTED_IP_HEADER=
# Upstash REST token for shared rate limiting; optional with the URL below.
UPSTASH_REDIS_REST_TOKEN=
# Upstash REST URL for shared rate limiting; optional, uses in-memory limits if unset.
UPSTASH_REDIS_REST_URL=
# Selects OpenRouter instead of Google AI Studio for receipt OCR; optional.
USE_OPENROUTER=false
